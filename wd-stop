#!/usr/bin/env bash
#
# wd-stop
#
# Safely shuts down the WD backup NAS and switches off its Shelly
# power controller after shutdown has been confirmed by power draw.
# Handles an already powered-off WD gracefully.
#
# Usage:
#   wd-stop
#
# Must be run as root.
#

set -uo pipefail

# {{{ Configuration
CONFIG_FILE='/etc/musicbackup.conf'

if [[ ! -r "$CONFIG_FILE" ]]; then
	RED=$'\033[1;31m' # Colors are defined in the config file, but here config is not available...
	RESET=$'\033[0m'
    printf "${RED}ERROR:${RESET} Cannot read %s\n" "$CONFIG_FILE" >&2
    exit 1
fi

# shellcheck source=/dev/null
source "$CONFIG_FILE"

# now we check if the needed variables are in from the config
if [[ ! -r "$LIB_FILE" ]]; then
    printf 'ERROR: Cannot read library: %s\n' "$LIB_FILE" >&2
    exit 1
fi

# shellcheck source=/dev/null
source "$LIB_FILE"

: "${WD_POWER_OFF_THRESHOLD:?WD_POWER_OFF_THRESHOLD is not defined in $CONFIG_FILE}"

[[ -x "$WD_SSH" ]] || {
    printf "${RED}ERROR:${RESET} wd-ssh not found or not executable: %s\n" "$WD_SSH" >&2
    exit 1
}

# }}} End of Configuration

printf "${CYAN}Stopping WD backup NAS...${RESET}\n"

# {{{ Check Shelly state

printf "  Checking Shelly state... "

STATE="$("$BIG_SHELLY" state 2>/dev/null)" || {
    printf "${RED}FAILED${RESET}\n"
    printf "${RED}ERROR:${RESET} Could not read Shelly state.\n" >&2
    exit 20
}

if [[ "$STATE" == "OFF" ]]; then
    printf "${GREEN}OFF${RESET}\n"
    printf "\n${GREEN}WD backup NAS is already safely powered off.${RESET}\n"
    exit 0
fi

printf "${GREEN}ON${RESET}\n"

# }}} End of Check Shelly state

# {{{ Check current power draw

printf "  Checking WD power draw... "

POWER="$("$BIG_SHELLY" power 2>/dev/null)" || {
    printf "${RED}FAILED${RESET}\n"
    printf "${RED}ERROR:${RESET} Could not read Shelly power consumption.\n" >&2
    exit 21
}

printf "%.1f W\n" "$POWER"

# }}} End of Check current power draw

# {{{ Unmount WD NFS mounts

printf "  Unmounting WD filesystems... "

UNMOUNT_FAILED=0

for MP in "${WD_MOUNT_POINTS[@]}"; do
    if grep -qs " $MP " /proc/mounts; then
        if ! sudo umount -f "$MP"; then
            UNMOUNT_FAILED=1
        fi
    fi
done

if (( UNMOUNT_FAILED )); then
    printf "${RED}FAILED${RESET}\n"
    printf "${RED}ERROR:${RESET} Could not unmount all WD filesystems.\n" >&2
    exit 22
fi

printf "${GREEN}OK${RESET}\n"

# }}} End unmount WD NFS mounts


# {{{ Shutdown WD if still running

if awk "BEGIN { exit !($POWER >= $WD_POWER_OFF_THRESHOLD) }"; then

    printf "  Sending shutdown command... "
	"$WD_SSH" 'sync; /usr/sbin/shutdown.sh >/dev/null 2>&1 &' >/dev/null 2>&1 || true
	printf "${GREEN}SENT${RESET}\n"
else
	printf "  WD already shut down... ${GREEN}OK${RESET}\n"
fi

# }}} End of Shutdown WD if still running

# {{{ Wait for power draw to drop

printf "  Waiting for WD power-down... "

elapsed=0
WAIT_STATUS_LAST=0

while true; do

    POWER="$("$BIG_SHELLY" power 2>/dev/null)" || {
        printf "${RED}FAILED${RESET}\n"
        printf "${RED}ERROR:${RESET} Could not read Shelly power consumption.\n" >&2
        exit 23
    }

    if awk "BEGIN { exit !($POWER < $WD_POWER_OFF_THRESHOLD) }"; then
        break
    fi

    sleep "$CHECK_INTERVAL"
    ((elapsed += CHECK_INTERVAL))
	wait_status "$elapsed"

    if (( elapsed >= WD_SHUTDOWN_TIMEOUT )); then
        printf "${RED}TIMEOUT${RESET}\n"
        printf "${RED}ERROR:${RESET} WD power draw did not fall below %.1f W.\n" \
            "$WD_POWER_OFF_THRESHOLD" >&2
        exit 24
    fi

done

printf "${GREEN}OK${RESET} (%.1f W)\n" "$POWER"

# }}} End of Wait for power draw to drop

# {{{ Power off Shelly

printf "  Powering off Shelly... "

if ! "$BIG_SHELLY" off >/dev/null; then
    printf "${RED}FAILED${RESET}\n"
    printf "${RED}ERROR:${RESET} WD shut down, but Shelly could not switch off.\n" >&2
    exit 25
fi

printf "${GREEN}OK${RESET}\n"

# }}} End of Power off Shelly

printf "\n${GREEN}WD backup NAS is safely powered off.${RESET}\n"
exit 0

