#!/usr/bin/env bash

set -uo pipefail

CONFIG_FILE='/etc/musicbackup.conf'

# {{{ Colors

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
RESET='\033[0m'

# }}}

# {{{ Configuration

if [[ ! -r "$CONFIG_FILE" ]]; then
    printf "${RED}ERROR:${RESET} Cannot read %s\n" "$CONFIG_FILE" >&2
    exit 1
fi

# shellcheck source=/dev/null
source "$CONFIG_FILE"

: "${WD_HOST:?WD_HOST is not defined in $CONFIG_FILE}"
: "${WD_POWER_OFF_THRESHOLD:?WD_POWER_OFF_THRESHOLD is not defined in $CONFIG_FILE}"

WD_SHUTDOWN_TIMEOUT=120
CHECK_INTERVAL=5

# }}}

printf "${CYAN}Stopping WD backup NAS...${RESET}\n"

# {{{ Shutdown

printf "  Sending shutdown command... "

if ! wd-ssh 'sync; poweroff' >/dev/null 2>&1; then
    printf "${RED}FAILED${RESET}\n"
    printf "${RED}ERROR:${RESET} Could not initiate WD shutdown.\n" >&2
    exit 20
fi

printf "${GREEN}OK${RESET}\n"

# }}}

# {{{ Wait until network disappears

printf "  Waiting for WD network shutdown... "

elapsed=0

while sudo /bin/ping -c 1 -W 2 "$WD_HOST" >/dev/null 2>&1; do
    sleep "$CHECK_INTERVAL"
    ((elapsed += CHECK_INTERVAL))

    if (( elapsed >= WD_SHUTDOWN_TIMEOUT )); then
        printf "${RED}TIMEOUT${RESET}\n"
        printf "${RED}ERROR:${RESET} WD did not leave the network within %d seconds.\n" \
            "$WD_SHUTDOWN_TIMEOUT" >&2
        exit 21
    fi
done

printf "${GREEN}OK${RESET}\n"

# }}}

# {{{ Wait for power draw to drop

printf "  Waiting for WD power-down... "

elapsed=0

while true; do
    POWER="$(shelly power 2>/dev/null)" || {
        printf "${RED}FAILED${RESET}\n"
        printf "${RED}ERROR:${RESET} Could not read Shelly power consumption.\n" >&2
        exit 22
    }

    if awk "BEGIN { exit !($POWER < $WD_POWER_OFF_THRESHOLD) }"; then
        break
    fi

    sleep "$CHECK_INTERVAL"
    ((elapsed += CHECK_INTERVAL))

    if (( elapsed >= WD_SHUTDOWN_TIMEOUT )); then
        printf "${RED}TIMEOUT${RESET}\n"
        printf "${RED}ERROR:${RESET} WD power draw did not fall below %.1f W.\n" \
            "$WD_POWER_OFF_THRESHOLD" >&2
        exit 23
    fi
done

printf "${GREEN}OK${RESET}\n"

# }}}

# {{{ Power off

printf "  Powering off Shelly... "

if ! shelly off >/dev/null; then
    printf "${RED}FAILED${RESET}\n"
    printf "${RED}ERROR:${RESET} WD shut down, but Shelly could not switch off.\n" >&2
    exit 24
fi

printf "${GREEN}OK${RESET}\n"

# }}}

printf "\n${GREEN}WD backup NAS is safely powered off.${RESET}\n"
exit 0

