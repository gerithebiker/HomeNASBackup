#!/usr/bin/env bash
#
# musicbackup
#
# Interactive wrapper for the Synology -> WD music backup system.
# Starts the WD backup NAS, runs the backup inside a GNU Screen
# session, then safely shuts down the WD after completion.
#
# Usage:
#   musicbackup
#   musicbackup --dry-run
#
# Options:
#   --dry-run    Preview changes without copying or deleting files.
#

set -Eeuo pipefail
START_EPOCH="$(date +%s)"

# {{{ Configuration
CONFIG_FILE='/etc/musicbackup.conf'

if [[ ! -r "$CONFIG_FILE" ]]; then
    RED=$'\033[1;31m' # Colors are defined in the config file, but here config is not available...
    RESET=$'\033[0m'
    printf "${RED}ERROR:${RESET} Cannot read %s\n" "$CONFIG_FILE" >&2
    exit 1
fi

# shellcheck source=/dev/null
source "$CONFIG_FILE"

# now we check if the needed variables are in from the config
if [[ ! -r "$LIB_FILE" ]]; then
    printf 'ERROR: Cannot read library: %s\n' "$LIB_FILE" >&2
    exit 1
fi

# shellcheck source=/dev/null
source "$LIB_FILE"

: "${WD_POWER_OFF_THRESHOLD:?WD_POWER_OFF_THRESHOLD is not defined in $CONFIG_FILE}"

[[ -x "$WD_SSH" ]] || {
    printf "${RED}ERROR:${RESET} wd-ssh not found or not executable: %s\n" "$WD_SSH" >&2
    exit 1
}

[[ -x "$BIG_SHELLY" ]] || {
    printf "${RED}ERROR:${RESET} bigShelly not found or not executable: %s\n" "$BIG_SHELLY" >&2
    exit 1
}

# Defining the script's own variables
SCREEN_BIN="/opt/sbin/screen"
SESSION_NAME="MusicBackup"
WINDOW_NAME="Backup"

# }}} End of Configuration

# {{{ Argument handling

MODE="LIVE"
BACKUP_ARGUMENT=""

case "${1:-}" in
    "")
        ;;

    --dry-run)
        MODE="DRY-RUN"
        BACKUP_ARGUMENT="--dry-run"
        ;;

    *)
        printf 'Usage: %s [--dry-run]\n' "$0" >&2
        exit 1
        ;;
esac

# }}} End Argument handling

# {{{ Prerequisite checks

[[ -x "$SCREEN_BIN" ]] ||
    die "GNU Screen was not found: $SCREEN_BIN"

[[ -x "$BACKUP_SCRIPT" ]] ||
    die "Backup script was not found or is not executable: $BACKUP_SCRIPT"

[[ -x "$WD_START" ]] ||
    die "WD start script was not found or is not executable: $WD_START"

[[ -x "$WD_STOP" ]] ||
    die "WD stop script was not found or is not executable: $WD_STOP"

command -v sudo >/dev/null 2>&1 ||
    die "sudo was not found."

# }}} End Prerequisite checks

# {{{ Prevent duplicate backup

EXISTING_PIDS="$(backup_pids)"

if [[ -n "$EXISTING_PIDS" || -d "$LOCK_DIR" ]]; then
    echo
    printf '%s************************************************************%s\n' \
        "$RED" "$RESET"
    printf '%s***  A music backup already appears to be running%s\n' \
        "$YELLOW" "$RESET"
    printf '%s************************************************************%s\n' \
        "$RED" "$RESET"
    echo

    if [[ -d "$LOCK_DIR" ]]; then
        printf '%sLock directory:%s %s\n' \
            "$CYAN" "$RESET" "$LOCK_DIR"
    fi

    if [[ -n "$EXISTING_PIDS" ]]; then
        printf '%sProcess IDs:%s %s\n' \
            "$CYAN" "$RESET" \
            "$(tr '\n' ' ' <<< "$EXISTING_PIDS")"
    fi

    echo
    printf 'Use %sbackupstatus%s for details.\n\n' \
        "$CYAN" "$RESET"

    exit 1
fi

# }}} End Prevent duplicate backup

# {{{ Existing Screen session handling

EXISTING_SESSION="$(screen_session_id)"

if [[ -n "$EXISTING_SESSION" ]]; then
    echo
    printf '%sAn existing Screen session named %s%s%s was found:%s\n' \
        "$YELLOW" "$CYAN" "$SESSION_NAME" "$YELLOW" "$RESET"
    printf '  %s%s%s\n\n' "$DIM" "$EXISTING_SESSION" "$RESET"

    read -r -p "Attach to it? [Y/n] " ANSWER

    case "$ANSWER" in
        ""|Y|y)
            exec "$SCREEN_BIN" -r "$EXISTING_SESSION"
            ;;

        *)
            printf '%sBackup was not started.%s\n' \
                "$YELLOW" "$RESET"
            exit 0
            ;;
    esac
fi

# }}} End Existing Screen session handling

# {{{ Build commands for Screen

printf -v QUOTED_BACKUP_SCRIPT '%q' "$BACKUP_SCRIPT"
printf -v QUOTED_WD_START '%q' "$WD_START"
printf -v QUOTED_WD_STOP '%q' "$WD_STOP"

if [[ -n "$BACKUP_ARGUMENT" ]]; then
    printf -v QUOTED_ARGUMENT '%q' "$BACKUP_ARGUMENT"
    RUN_COMMAND="sudo -- ${QUOTED_BACKUP_SCRIPT} ${QUOTED_ARGUMENT}"
else
    RUN_COMMAND="sudo -- ${QUOTED_BACKUP_SCRIPT}"
fi

# }}} End Build commands for Screen

# {{{ Screen command

SCREEN_COMMAND="
printf '\033[1;36mStarting WD music backup in ${MODE} mode...\033[0m\n\n'

# Start / verify WD
${QUOTED_WD_START}
START_CODE=\$?

if (( START_CODE != 0 )); then
    echo
    printf '\033[1;31mWD startup failed with exit code %d.\033[0m\n' \
        \"\$START_CODE\"
    echo
    printf 'Backup was not started.\n'
    echo
    printf 'Press Enter to continue to the shell...'
    read -r
    exec /usr/bin/bash -l
fi

echo

# Run backup
${RUN_COMMAND}
BACKUP_CODE=\$?

echo

# Always attempt a clean WD shutdown once the WD was successfully started
${QUOTED_WD_STOP}
STOP_CODE=\$?

echo

# Determine overall result
if (( BACKUP_CODE == 0 && STOP_CODE == 0 )); then

    printf '\033[1;32mBackup finished successfully.\033[0m\n'

    # Successful run: close the complete Screen session,
    # including all windows.
    "${SCREEN_BIN}" -S "${SESSION_NAME}" -X quit

else

    if (( BACKUP_CODE != 0 )); then
        printf '\033[1;31mBackup finished with exit code %d.\033[0m\n' \
            \"\$BACKUP_CODE\"
    fi

    if (( STOP_CODE != 0 )); then
        printf '\033[1;31mWD shutdown finished with exit code %d.\033[0m\n' \
            \"\$STOP_CODE\"
    fi

    echo
    printf 'Press Enter to continue to the shell...'
    read -r
    exec /usr/bin/bash -l
fi
"

# }}} End Screen command

# {{{ Start Screen

echo
printf '%s************************************************************%s\n' \
    "$GREEN" "$RESET"
printf '%s***  Starting %s%s%s%s\n' \
    "$YELLOW" "$CYAN" "$SESSION_NAME" "$YELLOW" "$RESET"
printf '%s***  Mode: %s%s%s\n' \
    "$YELLOW" "$CYAN" "$MODE" "$RESET"
printf '%s************************************************************%s\n' \
    "$GREEN" "$RESET"
echo

exec "$SCREEN_BIN" \
    -S "$SESSION_NAME" \
    -t "$WINDOW_NAME" \
    /usr/bin/bash -lc "$SCREEN_COMMAND"

# }}} End Start Screen

END_EPOCH="$(date +%s)"
DURATION=$((END_EPOCH - START_EPOCH))

printf "${GREEN}================= Time Report ==================${RESET}\n"
printf "${GREEN}Total runtime: %s ${CYAN}$(format_duration "$DURATION")${RESET}\n"
printf "${GREEN}================================================${RESET}\n"
