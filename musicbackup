#!/usr/bin/env bash
#
# Music Backup Wrapper script
#
# Usage:
#   musicbackup
#   musicbackup --dry-run
#

set -Eeuo pipefail

# {{{ Configuration

SCREEN_BIN="/opt/sbin/screen"
BACKUP_SCRIPT="$HOME/bin/synology_to_wd_music_backup.sh"
SESSION_NAME="MusicBackup"
WINDOW_NAME="Backup"
LOCK_DIR="/tmp/wd-music-backup.lock"

# }}} End Configuration

# {{{ Colors

RED=$'\033[1;31m'
GREEN=$'\033[1;32m'
YELLOW=$'\033[1;33m'
CYAN=$'\033[1;36m'
DIM=$'\033[2;37m'
RESET=$'\033[0m'

# }}} End Colors

# {{{ Functions

die() {
    printf '%sERROR:%s %s\n' "$RED" "$RESET" "$*" >&2
    exit 1
}

screen_session_id() {
    {
        "$SCREEN_BIN" -ls 2>/dev/null || true
    } |
        awk -v name="$SESSION_NAME" '
            $1 ~ ("\\." name "$") {
                print $1
                exit
            }
        '
}

backup_pids() {
    ps -eo pid=,args= |
        awk '
            /synology_to_wd_music_backup\.sh/ ||
            /rsync .*\/volume1\/music\// {
                print $1
            }
        '
}

# }}} End Functions

# {{{ Argument handling

MODE="LIVE"
BACKUP_ARGUMENT=""

case "${1:-}" in
    "")
        ;;

    --dry-run)
        MODE="DRY-RUN"
        BACKUP_ARGUMENT="--dry-run"
        ;;

    *)
        printf 'Usage: %s [--dry-run]\n' "$0" >&2
        exit 1
        ;;
esac

# }}} End Argument handling

# {{{ Prerequisite checks

[[ -x "$SCREEN_BIN" ]] ||
    die "GNU Screen was not found: $SCREEN_BIN"

[[ -f "$BACKUP_SCRIPT" ]] ||
    die "Backup script was not found: $BACKUP_SCRIPT"

[[ -x "$BACKUP_SCRIPT" ]] ||
    die "Backup script is not executable: $BACKUP_SCRIPT"

command -v sudo >/dev/null 2>&1 ||
    die "sudo was not found."

# }}} End Prerequisite checks

# {{{ Prevent duplicate backup

EXISTING_PIDS="$(backup_pids)"

if [[ -n "$EXISTING_PIDS" || -d "$LOCK_DIR" ]]; then
    echo
    printf '%s****************************************************%s\n' \
        "$RED" "$RESET"
    printf '%s***  A music backup already appears to be running%s\n' \
        "$YELLOW" "$RESET"
    printf '%s****************************************************%s\n' \
        "$RED" "$RESET"
    echo

    if [[ -d "$LOCK_DIR" ]]; then
        printf '%sLock directory:%s %s\n' \
            "$CYAN" "$RESET" "$LOCK_DIR"
    fi

    if [[ -n "$EXISTING_PIDS" ]]; then
        printf '%sProcess IDs:%s %s\n' \
            "$CYAN" "$RESET" \
            "$(tr '\n' ' ' <<< "$EXISTING_PIDS")"
    fi

    echo
    printf 'Use %sbackupstatus%s for details.\n\n' \
        "$CYAN" "$RESET"

    exit 1
fi

# }}} End Prevent duplicate backup

# {{{ Existing Screen session handling

EXISTING_SESSION="$(screen_session_id)"

if [[ -n "$EXISTING_SESSION" ]]; then
    echo
    printf '%sAn existing Screen session named %s%s%s was found:%s\n' \
        "$YELLOW" "$CYAN" "$SESSION_NAME" "$YELLOW" "$RESET"
    printf '  %s%s%s\n\n' "$DIM" "$EXISTING_SESSION" "$RESET"

    read -r -p "Attach to it? [Y/n] " ANSWER

    case "$ANSWER" in
        ""|Y|y)
            exec "$SCREEN_BIN" -r "$EXISTING_SESSION"
            ;;

        *)
            printf '%sBackup was not started.%s\n' \
                "$YELLOW" "$RESET"
            exit 0
            ;;
    esac
fi

# }}} End Existing Screen session handling

# {{{ Build command for Screen

printf -v QUOTED_SCRIPT '%q' "$BACKUP_SCRIPT"

if [[ -n "$BACKUP_ARGUMENT" ]]; then
    printf -v QUOTED_ARGUMENT '%q' "$BACKUP_ARGUMENT"
    RUN_COMMAND="sudo -- ${QUOTED_SCRIPT} ${QUOTED_ARGUMENT}"
else
    RUN_COMMAND="sudo -- ${QUOTED_SCRIPT}"
fi

# The sudo prompt appears inside the attached Screen session.
# After the backup finishes, keep an interactive shell available.
SCREEN_COMMAND="
printf '\033[1;36mStarting WD music backup in ${MODE} mode...\033[0m\n\n'

${RUN_COMMAND}
EXIT_CODE=\$?

echo
if (( EXIT_CODE == 0 )); then
    printf '\033[1;32mBackup finished successfully.\033[0m\n'
else
    printf '\033[1;31mBackup finished with exit code %d.\033[0m\n' \
        \"\$EXIT_CODE\"
fi

echo
printf 'Press Enter to continue to the shell...'
read -r

exec /usr/bin/bash -l
"

# }}} End Build command for Screen

echo
printf '%s****************************************************%s\n' \
    "$GREEN" "$RESET"
printf '%s***  Starting %s%s%s%s\n' \
    "$YELLOW" "$CYAN" "$SESSION_NAME" "$YELLOW" "$RESET"
printf '%s***  Mode: %s%s%s\n' \
    "$YELLOW" "$CYAN" "$MODE" "$RESET"
printf '%s****************************************************%s\n' \
    "$GREEN" "$RESET"
echo

exec "$SCREEN_BIN" \
    -S "$SESSION_NAME" \
    -t "$WINDOW_NAME" \
    /usr/bin/bash -lc "$SCREEN_COMMAND"

