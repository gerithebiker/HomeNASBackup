#!/usr/bin/env bash
#
# musicbackup-auto
#
# Unattended Synology -> WD music backup.
# Always attempts safe WD shutdown after starting the WD.
#

set -uo pipefail

START_EPOCH=$(date +%s)
START_TIME=$(date '+%Y-%m-%d %H:%M:%S')

# {{{ Configuration

CONFIG_FILE='/etc/musicbackup.conf'

if [[ ! -r "$CONFIG_FILE" ]]; then
    echo "ERROR: Cannot read $CONFIG_FILE" >&2
    exit 1
fi

source "$CONFIG_FILE"

if [[ ! -r "$LIB_FILE" ]]; then
    echo "ERROR: Cannot read library: $LIB_FILE" >&2
    exit 1
fi

source "$LIB_FILE"

# }}}

# {{{ Prerequisites

if (( EUID != 0 )); then
    echo "ERROR: Must run as root." >&2
    exit 1
fi

REQUIRED_SCRIPTS=(
    "$WD_START"
    "$WD_STOP"
    "$BACKUP_SCRIPT"
    "$MB_STATUS"
)

for SCRIPT in "${REQUIRED_SCRIPTS[@]}"; do
    if [[ ! -x "$SCRIPT" ]]; then
        echo "ERROR: Script unavailable: $SCRIPT" >&2
        exit 1
    fi
done

# Never shut down a WD potentially owned by another backup.
# Wrapper-level lock: protects the entire WD lifecycle.
AUTO_LOCK_DIR="${LOCK_DIR}.auto"

# Do not start if another backup is already running.
if ! mkdir "$AUTO_LOCK_DIR" 2>/dev/null; then
    echo "ERROR: Automatic backup already running." >&2
    exit 2
fi

trap 'rmdir "$AUTO_LOCK_DIR" 2>/dev/null || true' EXIT

if [[ -d "$LOCK_DIR" ]]; then
    echo "ERROR: Backup lock already exists: $LOCK_DIR" >&2
    exit 2
fi

# Temporary cleanup until the full EXIT handler is installed.
trap 'rmdir "$AUTO_LOCK_DIR" 2>/dev/null || true' EXIT

# }}}

# {{{ Logging

AUTO_TIMESTAMP=$(date '+%Y-%m-%d_%H-%M-%S')
AUTO_LOG="${LOG_DIR}/musicbackup_auto_${AUTO_TIMESTAMP}.log"

exec >>"$AUTO_LOG" 2>&1 || exit 1

log() {
    printf '[%s] %s\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

START_CODE=-1
BACKUP_CODE=-1
STOP_CODE=-1

# }}}

# {{{ Finalization

cleanup() {
    local ORIGINAL_RC=$?
    local END_EPOCH DURATION RESULT

    # Prevent recursive cleanup.
    trap - EXIT INT TERM

    log "Starting WD shutdown."

    if "$WD_STOP"; then
        STOP_CODE=0
        log "WD shutdown completed."
    else
        STOP_CODE=$?
        log "ERROR: WD shutdown failed (code $STOP_CODE)."
        log "WARNING: Manual intervention may be required."
    fi

	# Release lock only after confirmed safe shutdown.
    if (( STOP_CODE == 0 )); then
        if rmdir "$AUTO_LOCK_DIR"; then
            log "Wrapper lock released."
        else
            log "ERROR: Could not release wrapper lock: $AUTO_LOCK_DIR"
            STOP_CODE=26
        fi
    else
        log "WARNING: WD shutdown unsuccessful."
        log "Keeping wrapper lock: $AUTO_LOCK_DIR"
        log "Manual inspection required."
    fi

    END_EPOCH=$(date +%s)
    DURATION=$((END_EPOCH - START_EPOCH))

    if (( ORIGINAL_RC == 0 &&
          START_CODE == 0 &&
          BACKUP_CODE == 0 &&
          STOP_CODE == 0 )); then
        RESULT="SUCCESS"
    else
        RESULT="FAILED"
    fi

    printf '\n'
    printf '================ Backup Report ================\n'
    printf 'Status:          %s\n' "$RESULT"
    printf 'Started:         %s\n' "$START_TIME"
    printf 'Finished:        %s\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')"
    printf 'WD startup:      %s\n' "$START_CODE"
    printf 'Backup:          %s\n' "$BACKUP_CODE"
    printf 'WD shutdown:     %s\n' "$STOP_CODE"
    printf 'Total runtime:   %s\n' "$(format_duration "$DURATION")"
    printf '================================================\n'

    if [[ "$RESULT" == "SUCCESS" ]]; then
        log "Automatic backup completed successfully."
        exit 0
    fi

    log "ERROR: Automatic backup failed."

    # Preserve original failure code where possible.
    if (( ORIGINAL_RC != 0 )); then
        exit "$ORIGINAL_RC"
    fi

    exit 1
}

# Cleanup becomes active only after prerequisites.
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# }}}

# {{{ Start WD

log "Starting automatic WD music backup."
log "Powering on and initializing WD."

if "$WD_START"; then
    START_CODE=0
    log "WD startup completed."
else
    START_CODE=$?
    log "ERROR: WD startup failed (code $START_CODE)."
    exit "$START_CODE"
fi

# }}}

# {{{ Backup

BACKUP_START_EPOCH=$(date +%s)

log "Starting music backup."

if "$BACKUP_SCRIPT"; then
    BACKUP_CODE=0
else
    BACKUP_CODE=$?
fi

BACKUP_END_EPOCH=$(date +%s)
BACKUP_DURATION=$((BACKUP_END_EPOCH - BACKUP_START_EPOCH))

log "Backup finished with exit code $BACKUP_CODE."
log "Backup runtime: $(format_duration "$BACKUP_DURATION")"

exit "$BACKUP_CODE"

# }}} End
