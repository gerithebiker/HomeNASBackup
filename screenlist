#!/usr/bin/env bash

SCREEN_BIN="/opt/sbin/screen"

RED=$'\033[1;31m'
GREEN=$'\033[1;32m'
YELLOW=$'\033[1;33m'
CYAN=$'\033[1;36m'
DIM=$'\033[2;37m'
RESET=$'\033[0m'

if [[ ! -x "$SCREEN_BIN" ]]; then
    printf '%sGNU Screen not found: %s%s\n' "$RED" "$SCREEN_BIN" "$RESET" >&2
    exit 127
fi

mapfile -t SESSIONS < <(
    "$SCREEN_BIN" -ls 2>/dev/null |
    awk '/\((Detached|Attached)\)/ {print $1 "|" $2}'
)

if (( ${#SESSIONS[@]} == 0 )); then
    printf '%sNo GNU Screen sessions found.%s\n' "$YELLOW" "$RESET"
    exit 0
fi

echo
printf '%sGNU Screen sessions%s\n\n' "$GREEN" "$RESET"

INDEX=1

for ENTRY in "${SESSIONS[@]}"; do
    SESSION="${ENTRY%%|*}"
    STATUS="${ENTRY#*|}"
    STATUS="${STATUS#(}"
    STATUS="${STATUS%)}"

    TITLE="$(
        "$SCREEN_BIN" -S "$SESSION" -Q title 2>/dev/null |
        head -n 1
    )"

    [[ -n "$TITLE" ]] || TITLE="Unknown"

    if [[ "$STATUS" == "Attached" ]]; then
        STATUS_COLOR="$GREEN"
    else
        STATUS_COLOR="$YELLOW"
    fi

    printf '  %s%d)%s %-20s %s(%s)%s  %s[%s]%s\n' \
        "$YELLOW" "$INDEX" "$RESET" \
        "$TITLE" \
        "$DIM" "$SESSION" "$RESET" \
        "$STATUS_COLOR" "$STATUS" "$RESET"

    ((INDEX++))
done

echo
