#!/usr/bin/env bash

BASHRC="${HOME}/.bashrc"

RED=$'\033[1;31m'
GREEN=$'\033[1;32m'
YELLOW=$'\033[1;33m'
CYAN=$'\033[1;36m'
RESET=$'\033[0m'

# Column widths
ALIAS_WIDTH=12
DESCRIPTION_WIDTH=50

if [[ ! -r "$BASHRC" ]]; then
    printf '%sCannot read:%s %s\n' "$RED" "$RESET" "$BASHRC" >&2
    exit 1
fi

print_cmd() {
    local name="$1"
    local description="$2"
    local command="$3"

    printf '  %s%-*s%s %s%-*s%s %s%s%s\n' \
        "$CYAN" "$ALIAS_WIDTH" "$name" "$RESET" \
        "$GREEN" "$DESCRIPTION_WIDTH" "$description" "$RESET" \
        "$YELLOW" "$command" "$RESET"
}

echo
printf '%s****************************************************%s\n' \
    "$GREEN" "$RESET"
printf '%s***  Available aliases%s\n' \
    "$YELLOW" "$RESET"
printf '%s****************************************************%s\n\n' \
    "$GREEN" "$RESET"

printf '  %s%-*s%s %s%-*s%s %s%s%s\n' \
    "$CYAN" "$ALIAS_WIDTH" "Alias" "$RESET" \
    "$GREEN" "$DESCRIPTION_WIDTH" "Description" "$RESET" \
    "$YELLOW" "Command" "$RESET"

printf '  %s%-*s%s %s%-*s%s %s%s%s\n' \
    "$CYAN" "$ALIAS_WIDTH" "-----" "$RESET" \
    "$GREEN" "$DESCRIPTION_WIDTH" "-----------" "$RESET" \
    "$YELLOW" "-------" "$RESET"


FOUND=0

while IFS= read -r line; do
    NAME=""
    COMMAND=""
    DESCRIPTION=""

    # Single-quoted alias:
    # alias mb='musicbackup' # Start music backup
    if [[ $line =~ ^[[:space:]]*alias[[:space:]]+([[:alnum:]_]+)=\'([^\']*)\'[[:space:]]*(#[[:space:]]*:?[[:space:]]*(.*))?[[:space:]]*$ ]]; then
        NAME="${BASH_REMATCH[1]}"
        COMMAND="${BASH_REMATCH[2]}"
        DESCRIPTION="${BASH_REMATCH[4]}"

    # Double-quoted alias:
    # alias mb="musicbackup" # Start music backup
    elif [[ $line =~ ^[[:space:]]*alias[[:space:]]+([[:alnum:]_]+)=\"([^\"]*)\"[[:space:]]*(#[[:space:]]*:?[[:space:]]*(.*))?[[:space:]]*$ ]]; then
        NAME="${BASH_REMATCH[1]}"
        COMMAND="${BASH_REMATCH[2]}"
        DESCRIPTION="${BASH_REMATCH[4]}"
    else
        continue
    fi

    # Ha nincs komment, a parancs legyen a leírás is.
    if [[ -z "$DESCRIPTION" ]]; then
        DESCRIPTION="$COMMAND"
    fi

    print_cmd "$NAME" "$DESCRIPTION" "$COMMAND"
    FOUND=1

done < "$BASHRC"

if (( FOUND == 0 )); then
    printf '\n%sNo aliases found in %s.%s\n' \
        "$RED" "$BASHRC" "$RESET"
fi

echo

