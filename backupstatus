#!/usr/bin/env bash

BACKUP_SCRIPT="synology_to_wd_music_backup.sh"
LOG_DIR="/volume1/WD_NAS/BackupLogs"

RED=$'\033[1;31m'
GREEN=$'\033[1;32m'
YELLOW=$'\033[1;33m'
CYAN=$'\033[1;36m'
DIM=$'\033[2;37m'
RESET=$'\033[0m'

printf '\n%s****************************************************%s\n' "$GREEN" "$RESET"
printf '%s***  WD Music Backup Status%s\n' "$YELLOW" "$RESET"
printf '%s****************************************************%s\n\n' "$GREEN" "$RESET"

LOCK_DIR="/tmp/wd-music-backup.lock"

mapfile -t PIDS < <(
    ps -eo pid=,comm=,args= |
    awk '
        {
            pid  = $1
            comm = $2

            if (comm == "screen" || comm == "SCREEN")
                next

            if (comm == "vi" || comm == "vim" || comm == "nano")
                next

            if ($0 ~ /synology_to_wd_music_backup\.sh/ ||
                $0 ~ /rsync .*\/volume1\/music\//) {
                print pid
            }
        }
    ' |
    sort -u
)




if (( ${#PIDS[@]} > 0 )) || [[ -d "$LOCK_DIR" ]]; then
    printf '%sStatus:%s %sRUNNING%s\n' \
        "$CYAN" "$RESET" "$GREEN" "$RESET"

    if [[ -d "$LOCK_DIR" ]]; then
        printf '%sLock:%s    %sPresent%s\n' \
            "$CYAN" "$RESET" "$GREEN" "$RESET"
    fi

    for PID in "${PIDS[@]}"; do
        ELAPSED="$(
            ps -p "$PID" -o etime= 2>/dev/null |
            xargs
        )"

        COMMAND="$(
            ps -p "$PID" -o args= 2>/dev/null
        )"

        [[ -n "$COMMAND" ]] || continue

        printf '%sPID:%s     %s\n' "$CYAN" "$RESET" "$PID"
        printf '%sElapsed:%s %s\n' "$CYAN" "$RESET" "${ELAPSED:-unknown}"
        printf '%sCommand:%s %s\n' "$CYAN" "$RESET" "$COMMAND"
        echo
    done
else
    printf '%sStatus:%s %sNOT RUNNING%s\n\n' \
        "$CYAN" "$RESET" "$RED" "$RESET"
fi

LATEST_LOG="$(
    find "$LOG_DIR" \
        -maxdepth 1 \
        -type f \
        -name 'wd_music_backup_*.log' \
        -printf '%T@ %p\n' 2>/dev/null |
    sort -nr |
    head -n 1 |
    cut -d' ' -f2-
)"

if [[ -z "$LATEST_LOG" ]]; then
    printf '%sNo backup log found in:%s %s\n\n' \
        "$RED" "$RESET" "$LOG_DIR"
    exit 0
fi

printf '%sLatest log:%s %s\n' "$CYAN" "$RESET" "$LATEST_LOG"

LOG_TIME="$(
    stat -c '%y' "$LATEST_LOG" 2>/dev/null |
    cut -d'.' -f1
)"

[[ -n "$LOG_TIME" ]] &&
    printf '%sUpdated:%s    %s\n' "$CYAN" "$RESET" "$LOG_TIME"

echo

ERROR_COUNT="$(
    grep -cE 'ERROR:|Permission denied|rsync error:|failed:' \
        "$LATEST_LOG" 2>/dev/null || true
)"

if (( ERROR_COUNT > 0 )); then
    printf '%sErrors found:%s %s%d%s\n' \
        "$CYAN" "$RESET" "$RED" "$ERROR_COUNT" "$RESET"
else
    printf '%sErrors found:%s %s0%s\n' \
        "$CYAN" "$RESET" "$GREEN" "$RESET"
fi

LAST_TRANSFER="$(
    grep -E 'Number of regular files transferred:|Total transferred file size:|sent .* bytes|total size is' \
        "$LATEST_LOG" 2>/dev/null |
    tail -n 4
)"

if [[ -n "$LAST_TRANSFER" ]]; then
    echo
    printf '%sLast rsync summary:%s\n' "$YELLOW" "$RESET"
    printf '%s\n' "$LAST_TRANSFER"
fi

echo
printf '%sLast 20 log lines:%s\n' "$YELLOW" "$RESET"
printf '%s----------------------------------------------------%s\n' "$DIM" "$RESET"
tail -n 20 "$LATEST_LOG"
printf '%s----------------------------------------------------%s\n\n' "$DIM" "$RESET"
