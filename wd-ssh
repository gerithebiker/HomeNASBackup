#!/usr/bin/env bash
#
# wd-ssh
#
# SSH wrapper for the WD backup NAS.
# Uses Expect to provide password authentication and allows commands
# to be executed on the WD without interactive password entry.
#
# Usage:
#   wd-ssh [command [arguments...]]
#
# Examples:
#   wd-ssh uptime
#   wd-ssh 'cat /etc/version'
#

set -euo pipefail

CONFIG_FILE='/etc/musicbackup.conf'

if [[ ! -r "$CONFIG_FILE" ]]; then
    RED=$'\033[1;31m' # Colors are defined in the config file, but here config is not available...
    RESET=$'\033[0m'
    printf "${RED}ERROR:${RESET} Cannot read %s\n" "$CONFIG_FILE" >&2
    exit 1
fi

source "$CONFIG_FILE"

COMMAND="${*:-true}"

for attempt in 1 2 3; do

    /opt/bin/expect <<EOF
set timeout 15

spawn ssh \
    -o StrictHostKeyChecking=yes \
	-o UserKnownHostsFile="${SSH_KNOWN_HOSTS}" \
    -o ConnectTimeout=5 \
    "${WD_SSH_USER}@${WD_HOST}" \
    "$COMMAND"

expect {
    "*assword:*" {
        send -- "${WD_SSH_PASSWORD}\r"
        exp_continue
    }
    eof
}

catch wait result
exit [lindex \$result 3]
EOF

    RC=$?

    if (( RC == 0 )); then
        exit 0
    fi

    if (( attempt < 3 )); then
        echo "WD not ready yet, retrying in 5 seconds..." >&2
        sleep 5
    fi
done

echo "ERROR: Unable to establish SSH connection to WD." >&2
exit 1

