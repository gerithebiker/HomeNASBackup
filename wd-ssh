#!/usr/bin/env bash
#
# wd-ssh
#
# SSH wrapper for the WD backup NAS.
# Uses Expect to provide password authentication and allows commands
# to be executed on the WD without interactive password entry.
#
# Usage:
#   wd-ssh [command [arguments...]]
#
# Examples:
#   wd-ssh uptime
#   wd-ssh 'cat /etc/version'
#

if [[ ! -x /opt/bin/expect ]]; then
    echo "ERROR: Expect is missing. Check Entware installation." >&2
    exit 127
fi

set -euo pipefail

CONFIG_FILE='/etc/musicbackup.conf'

if [[ ! -r "$CONFIG_FILE" ]]; then
    RED=$'\033[1;31m' # Colors are defined in the config file, but here config is not available...
    RESET=$'\033[0m'
    printf "${RED}ERROR:${RESET} Cannot read %s\n" "$CONFIG_FILE" >&2
    exit 1
fi

source "$CONFIG_FILE"

COMMAND="${*:-true}"

LAST_RC=1

for attempt in 1 2 3; do

    if /opt/bin/expect <<EOF
set timeout 15

spawn ssh \
    -o StrictHostKeyChecking=yes \
    -o UserKnownHostsFile="${SSH_KNOWN_HOSTS}" \
    -o ConnectTimeout=5 \
    -o ConnectionAttempts=1 \
    "${WD_SSH_USER}@${WD_HOST}" \
    "$COMMAND"

expect {
    "*assword:*" {
        send -- "${WD_SSH_PASSWORD}\r"
        exp_continue
    }
    timeout {
        puts stderr "ERROR: SSH interaction timed out."
        exit 124
    }
    eof
}

if {[catch {wait} result]} {
    puts stderr "ERROR: Could not retrieve SSH exit status."
    exit 125
}

exit [lindex \$result 3]
EOF
    then
        exit 0
    else
        LAST_RC=$?
    fi

    if (( attempt < 3 )); then
        printf 'WD SSH attempt %d failed (code %d); retrying...\n' \
            "$attempt" "$LAST_RC" >&2
        sleep 5
    fi
done

printf 'ERROR: WD SSH failed after three attempts (code %d).\n' \
    "$LAST_RC" >&2

exit "$LAST_RC"
